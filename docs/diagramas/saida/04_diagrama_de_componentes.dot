digraph comps {
rankdir=LR; ranksep=0.45; nodesep=0.2; newrank=true; compound=true;
graph [fontname="DejaVu Sans", fontsize=13, pad=0.3, bgcolor=white];
node [fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9];
gw [shape=component, style=filled, fillcolor="#e9e4f3", label="«component»\nAPI Gateway\n:8000"];
subgraph cluster_auth { label="auth-service  :8001"; style="filled"; fillcolor="#e6ecf7"; color="#6f86b8"; fontsize=12;
auth_c [shape=component, style=filled, fillcolor="#dcecee", label="«component»\nAuthController\n(main.py)"];
auth_s [shape=component, style=filled, fillcolor="#dcecee", label="«component»\nAuthService\n(service.py)"];
auth_i [shape=box, style="filled", fillcolor="#fff7d6", label="«interface»\nAuthProvider"];
auth_v0 [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD BGCOLOR="black"><FONT COLOR="white"><B>V</B></FONT></TD><TD>«component»<BR/>EmailPasswordProvider</TD></TR></TABLE>>];
auth_v1 [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD BGCOLOR="black"><FONT COLOR="white"><B>V</B></FONT></TD><TD>«component»<BR/>SocialProvider</TD></TR></TABLE>>];
auth_r [shape=component, style=filled, fillcolor="#e3f0e4", label="«component»\nUserRepository\n(repository.py)"];
auth_db [label="SQLite\nauth.db", shape=cylinder, style=filled, fillcolor=white];
vp_auth [shape=triangle, style=filled, fillcolor=white, width=1.2, height=1.0, margin=0, label=<<FONT POINT-SIZE="10"><B>Autenticação</B></FONT><BR/><FONT POINT-SIZE="9">[1,2]</FONT>> ];
}
gw -> auth_c [color="#8a7fb0"];
auth_c -> auth_s;
auth_s -> auth_i [style=dashed, arrowhead=vee, label=" usa"];
auth_i -> auth_v0 [dir=back, arrowtail=onormal, style=dashed];
auth_v0 -> vp_auth [dir=none, style=dashed];
auth_i -> auth_v1 [dir=back, arrowtail=onormal, style=dashed];
auth_v1 -> vp_auth [dir=none, style=dashed];
auth_s -> auth_r;
auth_r -> auth_db;
